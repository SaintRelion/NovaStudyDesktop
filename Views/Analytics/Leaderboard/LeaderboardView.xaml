<UserControl
    x:Class="Views.Analytics.LeaderboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="#F5F3EE">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,15"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Foreground="#FFD700"
                        Kind="TrophyVariant" />
                    <TextBlock
                        Margin="12,0,24,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Black"
                        Text="Leaderboard" />

                    <ComboBox
                        x:Name="cmbCategoryFilter"
                        Width="250"
                        materialDesign:HintAssist.Hint="Filter by Subject"
                        SelectionChanged="cmbCategoryFilter_SelectionChanged"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="10,0,0,0"
                        Click="Refresh_Click"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstLeaderboards" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,40">
                            <Border
                                Margin="0,0,0,15"
                                Padding="12,4"
                                BorderBrush="#2196F3"
                                BorderThickness="4,0,0,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Black"
                                    Opacity="0.8"
                                    Text="{Binding topic_name}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding top_performers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,4"
                                            Padding="16,12"
                                            Background="White"
                                            CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="10"
                                                    Opacity="0.05"
                                                    ShadowDepth="1" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    HorizontalAlignment="Left"
                                                    Background="#EEE"
                                                    CornerRadius="16">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Black"
                                                        Opacity="0.5"
                                                        Text="{Binding rank}" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Text="{Binding student_name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.5"
                                                        Text="{Binding total_items, StringFormat='{}{0} Questions Answered'}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="18"
                                                        FontWeight="Black"
                                                        Foreground="#2E7D32"
                                                        Text="{Binding percentage, StringFormat='{}{0}%'}"
                                                        TextAlignment="Right" />
                                                    <ProgressBar
                                                        Height="4"
                                                        Margin="0,4,0,0"
                                                        Background="#E8F5E9"
                                                        Foreground="#2E7D32"
                                                        Value="{Binding percentage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            x:Name="pnlLoading"
            Grid.RowSpan="2"
            Panel.ZIndex="1000"
            Background="White"
            Opacity="0.8"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="40"
                    Height="40"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
                <TextBlock
                    Margin="0,15"
                    FontWeight="Black"
                    Opacity="0.5"
                    Text="CALCULATING EXCELLENCE..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
