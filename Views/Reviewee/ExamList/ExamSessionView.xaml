<UserControl
    x:Class="Views.Reviewee.ExamSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <Storyboard x:Key="TransitionToExam">
            <DoubleAnimation
                Storyboard.TargetName="pnlExamList"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.2" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pnlExamList" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ctrlActiveExam" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation
                BeginTime="0:0:0.2"
                Storyboard.TargetName="ctrlActiveExam"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="ExitExamAnimation">
            <DoubleAnimation
                Storyboard.TargetName="ctrlActiveExam"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.2" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ctrlActiveExam" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pnlExamList" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation
                BeginTime="0:0:0.2"
                Storyboard.TargetName="pnlExamList"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.3" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid x:Name="pnlExamList">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="24"
                Background="White"
                BorderBrush="#EEE"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppInk}"
                        Text="Available assessments" />
                    <TextBlock
                        Margin="0,0,0,15"
                        Foreground="{StaticResource AppMuted}"
                        Text="Choose an assessment to begin or continue your review." />

                    <Grid>
                        <TextBox
                            x:Name="txtSearchExam"
                            Padding="12,8"
                            materialDesign:HintAssist.Hint="Search for exams..."
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            TextChanged="txtSearchExam_TextChanged" />
                        <materialDesign:PackIcon
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Kind="Magnify"
                            Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstExams" Margin="24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#2196F3"
                                    Text="{Binding exam_date}" />

                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding exams}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="320"
                                                Margin="0,0,12,12"
                                                Padding="16"
                                                Background="White"
                                                CornerRadius="8"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="ExamCard_Click">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Direction="270"
                                                        Opacity="0.05"
                                                        ShadowDepth="2" />
                                                </Border.Effect>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /> 
                                                        <ColumnDefinition Width="*" />    
                                                        <ColumnDefinition Width="Auto" /> 
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Column="0"
                                                        Width="48"
                                                        Height="48"
                                                        Background="#F1F2F6"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="20"
                                                            FontWeight="Black"
                                                            Foreground="#1ABC9C"
                                                            Text="{Binding category_name[0]}" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="Bold"
                                                            Foreground="#2D3436"
                                                            Text="{Binding exam_name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="Black"
                                                                Foreground="#1ABC9C"
                                                                Text="{Binding category_name}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="#A4B0BE"
                                                                Text="{Binding created_at, StringFormat='  •  {0}'}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="8,6"
                                                        VerticalAlignment="Center"
                                                        Background="#F7F8F4"
                                                        CornerRadius="6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Foreground="#636E72"
                                                                Kind="ChartLine" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                FontSize="10"
                                                                FontWeight="Black"
                                                                Foreground="#2D3436"
                                                                Text="{Binding metric_count}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="txtExamListStatus" Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AppMuted}" Text="No assessments are available yet." Visibility="Collapsed" />
        </Grid>

        <local:ActiveExamView
            x:Name="ctrlActiveExam"
            Opacity="0"
            RequestExit="OnExamFinished"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
