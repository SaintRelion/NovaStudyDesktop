<UserControl
    x:Class="Views.Account.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{StaticResource AppCanvas}">
    <Grid>
        <materialDesign:Card
            Width="450"
            Padding="40"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1"
            UniformCornerRadius="18">
            <StackPanel>
                <materialDesign:PackIcon
                    Width="64"
                    Height="64"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Foreground="#176B5C"
                    Kind="AccountCircle" />

                <TextBlock
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Black"
                    Text="YOUR PROFILE" />
                <TextBlock
                    x:Name="lblRoleBadge"
                    Margin="0,0,0,32"
                    Padding="8,2"
                    HorizontalAlignment="Center"
                    Background="#176B5C"
                    FontSize="10"
                    FontWeight="Black"
                    Foreground="White"
                    Text="STUDENT" />

                <TextBox
                    x:Name="txtId"
                    materialDesign:HintAssist.Hint="System Identifier"
                    IsReadOnly="True"
                    Opacity="0.5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <TextBox
                    x:Name="txtUsername"
                    Margin="0,20,0,0"
                    materialDesign:HintAssist.Hint="Username"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <TextBox
                    x:Name="txtEmail"
                    Margin="0,20,0,0"
                    materialDesign:HintAssist.Hint="Email Address"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="Gray"
                        Text="ACCESS STATUS:" />
                    <TextBlock
                        x:Name="txtStatus"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#2E7D32"
                        Text="ACTIVE" />
                </StackPanel>

                <Button
                    x:Name="btnUpdate"
                    Height="50"
                    Margin="0,40,0,0"
                    Background="#176B5C"
                    Click="UpdateAccount_Click"
                    Content="Save changes"
                    FontWeight="Bold" />

                <TextBlock
                    x:Name="lblUpdateStatus"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
