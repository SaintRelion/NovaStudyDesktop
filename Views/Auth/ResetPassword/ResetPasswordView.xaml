<UserControl
    x:Class="Views.Auth.ResetPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="{StaticResource AppCanvas}">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="22,22,22,0" Background="{StaticResource BrandDeep}" CornerRadius="16,16,0,0">
            <StackPanel Margin="36,22">
                <TextBlock FontSize="19" FontWeight="Bold" Foreground="White" Text="nova study" />
                <TextBlock Margin="0,14,0,0" FontSize="24" FontWeight="SemiBold" Foreground="White" Text="Recover access to your workspace" />
            </StackPanel>
        </Border>
        <materialDesign:Card
            Grid.Row="1"
            Width="500"
            Margin="22,-20,22,22"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            UniformCornerRadius="12">
            <StackPanel>
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    Margin="0,0,0,10"
                    Foreground="{StaticResource BrandPrimary}"
                    Kind="KeyChange" />

                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AppInk}"
                    Text="Reset password" />
                <TextBlock
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text="We’ll send a verification code to your registered email address."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <StackPanel x:Name="pnlRequest" Visibility="Visible">
                    <TextBox
                        x:Name="txtResetEmail"
                        materialDesign:HintAssist.Hint="Email address"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <Button
                        x:Name="btnRequestToken"
                        Height="45"
                        Margin="0,24,0,0"
                        Background="#173D3C"
                        Click="RequestToken_Click"
                        Content="Send verification code"
                        FontWeight="Bold" />
                </StackPanel>

                <StackPanel x:Name="pnlVerify" Visibility="Collapsed">
                    <TextBox
                        x:Name="txtToken"
                        materialDesign:HintAssist.Hint="Verification code"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <PasswordBox
                        x:Name="txtNewPassword"
                        Margin="0,16,0,0"
                        materialDesign:HintAssist.Hint="New password"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />
                    <Button
                        x:Name="btnConfirmReset"
                        Height="45"
                        Margin="0,24,0,0"
                        Background="#176B5C"
                        BorderBrush="#176B5C"
                        Click="ConfirmReset_Click"
                        Content="Update password"
                        FontWeight="Bold" />
                </StackPanel>

                <TextBlock
                    x:Name="lblResetStatus"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#E05275"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,16,0,0"
                    Click="BackToLogin_Click"
                    Content="Back to sign in"
                    Foreground="#176B5C"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
