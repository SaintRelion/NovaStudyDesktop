<UserControl x:Class="Views.Auth.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{StaticResource AppCanvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28" MaxWidth="1180" VerticalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource BrandDeep}" CornerRadius="20">
                <Grid Margin="32,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Background="{StaticResource BrandAccent}" CornerRadius="10">
                            <materialDesign:PackIcon Kind="BookEducationOutline" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="nova study" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="btnExit" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" Click="Exit_Click" ToolTip="Close application" Foreground="#C8DFD5" Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,24">
                        <TextBlock Text="YOUR ASSESSMENT WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#9BD2BE" TextAlignment="Center"/>
                        <TextBlock Text="Make room for your next discovery." FontSize="36" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,10"/>
                        <TextBlock Text="Your materials, practice, and progress. One place to move forward." FontSize="14" Foreground="#C8DFD5" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Width="560" MaxWidth="560" HorizontalAlignment="Center" Margin="0,-34,0,0" Padding="32,26" Background="White" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="16">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.08" Color="#173D3C"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Welcome back" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AppInk}"/>
                    <TextBlock Text="Sign in to continue your learning journey." FontSize="13" Foreground="{StaticResource AppMuted}" Margin="0,6,0,22" TextWrapping="Wrap"/>
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtUsername" Height="48" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Enter your username" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" VerticalAlignment="Center"/>
                        <Button Click="ForgotPassword_Click" Content="Forgot password?" FontSize="12" Height="26" Padding="0" HorizontalAlignment="Right" Foreground="{StaticResource BrandPrimary}" Style="{StaticResource MaterialDesignFlatButton}"/>
                    </Grid>
                    <PasswordBox x:Name="txtPassword" Height="48" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Enter your password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                    <Button x:Name="btnLogin" Height="48" Margin="0,22,0,0" Background="{StaticResource BrandPrimary}" BorderBrush="{StaticResource BrandPrimary}" Foreground="White" Click="Login_Click" IsDefault="True" FontSize="14" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Enter workspace" VerticalAlignment="Center"/><materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="lblStatus" Margin="0,10,0,0" FontSize="12" Foreground="#B4494C" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="New to NovaStudy?" FontSize="12" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center"/>
                            <Button Click="ShowSignup_Click" Content="Create an account" FontSize="12" Margin="4,0,0,0" Padding="8,4" Foreground="{StaticResource BrandPrimary}" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
