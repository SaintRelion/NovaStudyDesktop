<UserControl x:Class="Views.Auth.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{StaticResource AppCanvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16" MaxWidth="1180" VerticalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource BrandDeep}" CornerRadius="20">
                <Grid Margin="28,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="32" Height="32" Background="{StaticResource BrandAccent}" CornerRadius="9">
                            <materialDesign:PackIcon Kind="BookEducationOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="nova study" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,12,12,16">
                        <TextBlock Text="A place to learn. A clearer way to grow." FontSize="30" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Bring your materials, assessments, and progress together." FontSize="13" Foreground="#C8DFD5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Width="560" HorizontalAlignment="Center" Margin="0,-24,0,0" Padding="30,20" Background="White" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="16">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.08" Color="#173D3C"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Create your account" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,4"/>
                    <TextBlock Text="A few details to make this workspace yours." FontSize="14" Foreground="{StaticResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtRegUsername" Height="44" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Choose a username" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="Email address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtRegEmail" Height="44" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="you@example.com" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtRegPassword" Height="44" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Create a password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="Workspace role" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbRole" Height="48" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8">
                        <ComboBoxItem Content="Reviewee" ToolTip="Practice and track your progress" IsSelected="True"/>
                        <ComboBoxItem Content="ReviewDirector" ToolTip="Organize assessments"/>
                        <ComboBoxItem Content="Admin" ToolTip="Manage your workspace"/>
                    </ComboBox>
                    <Border Background="#EDF5F0" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <TextBlock Text="New accounts need administrator approval before sign-in." Foreground="#386659" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Button x:Name="btnRegister" Height="44" Background="{StaticResource BrandPrimary}" BorderBrush="{StaticResource BrandPrimary}" Foreground="White" Click="Register_Click" Content="Create account" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblRegStatus" Margin="0,10,0,0" FontSize="12" Foreground="#B4494C" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Already have an account?" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center" FontSize="12"/>
                        <Button Click="BackToLogin_Click" Content="Sign in" Margin="4,0,0,0" Padding="8,4" Foreground="{StaticResource BrandPrimary}" Style="{StaticResource MaterialDesignFlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
