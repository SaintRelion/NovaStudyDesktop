<UserControl
    x:Class="Components.RevieweeSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border
        Background="White"
        BorderBrush="#DDD"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="Auto" />
                <!--  Search Bar  -->
                <RowDefinition Height="*" />
                <!--  List  -->
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="16"
                Background="#F9F9F9">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        FontWeight="Black"
                        Opacity="0.6"
                        Text="SELECT REVIEWEE" />
                    <TextBlock
                        x:Name="txtContext"
                        Margin="0,4,0,0"
                        FontSize="10"
                        Foreground="{StaticResource BrandPrimary}"
                        Text="Global Overview" />
                </StackPanel>
            </Border>

            <!--  Search Bar[cite: 6]  -->
            <Border
                Grid.Row="1"
                Padding="12,0,12,12"
                Background="#F9F9F9">
                <Grid>
                    <TextBox
                        x:Name="txtSearch"
                        Padding="10,8,30,8"
                        materialDesign:HintAssist.Hint="Search by name..."
                        FontSize="12"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextChanged="txtSearch_TextChanged" />
                    <materialDesign:PackIcon
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Kind="Magnify"
                        Opacity="0.5" />
                </Grid>
            </Border>

            <ListBox
                x:Name="lstReviewees"
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="lstReviewees_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="brdStatus"
                            Padding="12"
                            BorderThickness="4,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!--  Default: Red for haven't taken  -->
                                    <Setter Property="BorderBrush" Value="#FF5252" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <!--  Green: Successfully taken[cite: 6]  -->
                                        <DataTrigger Binding="{Binding has_taken}" Value="True">
                                            <Setter Property="BorderBrush" Value="#4CAF50" />
                                        </DataTrigger>
                                        <!--  Highlight selection[cite: 6]  -->
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="#F1F2F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Kind="AccountCircle"
                                    Opacity="0.5" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock FontWeight="Bold" Text="{Binding username}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="{Binding email}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Loading Panel[cite: 6]  -->
            <Border
                x:Name="pnlLoading"
                Grid.RowSpan="3"
                Background="White"
                Opacity="0.7"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar
                        Width="30"
                        Height="30"
                        IsIndeterminate="True"
                        Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="Black"
                        Opacity="0.5"
                        Text="LOADING REVIEWEES..." />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
