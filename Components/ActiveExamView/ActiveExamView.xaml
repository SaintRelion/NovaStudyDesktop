<UserControl
    x:Class="Components.ActiveExamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <local:EqualityConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <Grid x:Name="pnlActiveExam">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24" Background="#1A1A1A">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock
                        x:Name="txtActiveExamTitle"
                        Background="Transparent"
                        FontSize="24"
                        FontWeight="Black"
                        Foreground="White"
                        MouseDown="txtActiveExamTitle_MouseDown"
                        Text="EXAMINATION TITLE" />
                    <TextBlock
                        x:Name="txtActiveExamCategory"
                        FontSize="12"
                        Foreground="#888"
                        Text="ATTEMPT 1 OF 3" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="btnExit_Click"
                    Foreground="#FF5252"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Kind="ExitToApp" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="EXIT SESSION" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="24,12"
            Background="#222">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Progress: Q x of N  /  REVIEW phase label  -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="txtPhaseLabel"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#888"
                        Text="QUESTION PHASE" />
                    <ProgressBar
                        x:Name="pbProgress"
                        Height="4"
                        Margin="0,6,0,0"
                        Background="#444"
                        Foreground="{StaticResource BrandPrimary}"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                </StackPanel>

                <!--  Countdown clock  -->
                <Border
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    Padding="16,8"
                    Background="{StaticResource BrandPrimary}"
                    CornerRadius="8">
                    <TextBlock
                        x:Name="txtTimer"
                        FontSize="22"
                        FontWeight="Black"
                        Foreground="White"
                        Text="00:00" />
                </Border>
            </Grid>
        </Border>

        <!--  ═══ CONTENT AREA ═══  -->
        <Grid Grid.Row="2">

            <!--  ── SINGLE QUESTION VIEW (per-question phase) ──  -->
            <Border
                x:Name="pnlSingleQuestion"
                Padding="24"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <materialDesign:Card
                            Margin="0,0,8,0"
                            Padding="28"
                            Background="White"
                            UniformCornerRadius="14">
                            <StackPanel>
                        <TextBlock
                            x:Name="txtQuestionNumber"
                            Margin="0,0,0,6"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrandPrimary}"
                            Text="QUESTION 1 OF 100" />
                        <TextBlock
                            x:Name="txtQuestionText"
                            Margin="0,0,0,24"
                            FontSize="17"
                            FontWeight="Medium"
                            Text=""
                            TextWrapping="Wrap" />

                        <ItemsControl x:Name="icCurrentChoices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Margin="0,6" Checked="Option_Checked" GroupName="CurrentQuestion" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="{Binding Label}" /><Run Text=". " /><Run Text="{Binding Text}" />
                                        </TextBlock>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>
                    <Button
                        x:Name="btnNext"
                        Grid.Row="1"
                        Margin="0,12,8,0"
                        Padding="16,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#1A1A1A"
                        Click="btnNext_Click"
                        Content="NEXT QUESTION →"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </Grid>
            </Border>

            <!--  ── REVIEW VIEW (all questions, scrollable) ──  -->
            <ScrollViewer
                x:Name="pnlReview"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <!--  Review phase banner  -->
                    <Border
                        Margin="32,24,32,0"
                        Padding="16,12"
                        Background="#FFF8E1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                VerticalAlignment="Center"
                                Foreground="#F9A825"
                                Kind="AlertCircleOutline" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#F9A825"
                                Text="REVIEW MODE — Check unanswered or change responses before submitting." />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="icQuestions" Margin="32,16,32,32">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,16"
                                    Padding="20"
                                    Background="White"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Black"
                                            Opacity="0.3"
                                            Text="{Binding DisplayId, StringFormat='{}{0}.'}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Margin="0,0,0,15"
                                                FontSize="16"
                                                FontWeight="Medium"
                                                Text="{Binding QuestionData.question_text}"
                                                TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Choices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Margin="0,5" Checked="Option_Checked" GroupName="{Binding QuestionId}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run FontWeight="Bold" Text="{Binding Label}" /><Run Text=". " /><Run Text="{Binding Text}" />
                                                            </TextBlock>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  READ-ONLY overlay  -->
            <Grid x:Name="pnlReadOnly" Visibility="Collapsed">
                <Border Background="Black" Opacity="0.05" />
                <Border
                    Padding="10"
                    VerticalAlignment="Top"
                    Background="#FF5252">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="AlertDecagram" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Black"
                            Foreground="White"
                            Text="READ-ONLY MODE: ATTEMPTS EXHAUSTED" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Submit loading overlay  -->
            <Border
                x:Name="pnlSubmitLoading"
                Panel.ZIndex="1000"
                Background="White"
                Opacity="0.7"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Text="VALIDATING AND SUBMITTING..." />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ═══ FOOTER ═══  -->
        <Border
            Grid.Row="3"
            Padding="32,24"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="btnSubmit"
                Height="54"
                Background="#1A1A1A"
                Click="btnSubmit_Click"
                Content="FINALIZE AND SUBMIT"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Visibility="Collapsed" />
        </Border>
    </Grid>
</UserControl>
