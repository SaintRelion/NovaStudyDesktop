<UserControl
    x:Class="Components.ItemAnalysisView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="White">

    <UserControl.Resources>
        <Style x:Key="AnalysisRowStyle" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="MinHeight" Value="42" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="#0D1117" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalysisCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>


    </UserControl.Resources>

    <Border
        Padding="12"
        Background="White"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Row 0: Title bar  -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        x:Name="txtTitle"
                        FontSize="15"
                        FontWeight="Black"
                        Foreground="#1E293B"
                        Text="ITEM ANALYSIS" />
                    <TextBlock
                        x:Name="txtItemCount"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#94A3B8"
                        Text="— items" />
                    <!-- <Button
                        x:Name="btnExportPdf"
                        Margin="8,0"
                        Padding="12,6"
                        Background="#2563EB"
                        Click="btnExportPdf_Click"
                        Content="⬇ Export PDF"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White" />-->
                </StackPanel>
                <Button
                    x:Name="btnDeepAnalysis"
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="btnDeepAnalysis_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="Open Deep Analysis for selected date">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Magnify" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="DEEP ANALYSIS" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Row 1: AI Batch Summary  -->
            <Border
                x:Name="pnlSummary"
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,10"
                Background="#F0F4FF"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="#247968"
                        CornerRadius="8">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="RobotOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,3"
                            FontSize="9"
                            FontWeight="Black"
                            Foreground="#247968"
                            Text="AI BATCH INSIGHT" />
                        <TextBlock
                            x:Name="txtBatchSummary"
                            FontSize="12"
                            Foreground="#334155"
                            LineHeight="18"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Row 2: Batch progression timeline  -->
            <Border
                x:Name="pnlBatchStrip"
                Grid.Row="2"
                Margin="0,0,0,12"
                Padding="14,12"
                Background="#F7F8F4"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="#94A3B8"
                            Kind="TrendingUp" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="#94A3B8"
                            Text="BATCH PROGRESSION" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="icBatchStats">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="110"
                                        Margin="0,0,8,0"
                                        Padding="10,8"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9"
                                                FontWeight="Black"
                                                Foreground="#64748B"
                                                Text="{Binding DateLabel}" />
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="20"
                                                FontWeight="Black"
                                                Foreground="{Binding AvgColor}"
                                                Text="{Binding AvgCorrect, StringFormat={}{0:N0}%}" />
                                            <ProgressBar
                                                Height="4"
                                                Margin="0,0,0,6"
                                                Background="#E2E8F0"
                                                BorderThickness="0"
                                                Foreground="{Binding AvgColor}"
                                                Maximum="100"
                                                Value="{Binding AvgCorrect}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Margin="0,0,3,0"
                                                    Padding="4,1"
                                                    Background="#FEF2F2"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Black"
                                                        Foreground="#E53935"
                                                        Text="{Binding HardCount, StringFormat={}H:{0}}" />
                                                </Border>
                                                <Border
                                                    Margin="0,0,3,0"
                                                    Padding="4,1"
                                                    Background="#FFF7ED"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Black"
                                                        Foreground="#FB8C00"
                                                        Text="{Binding ModCount, StringFormat={}M:{0}}" />
                                                </Border>
                                                <Border
                                                    Padding="4,1"
                                                    Background="#F0FDF4"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Black"
                                                        Foreground="#43A047"
                                                        Text="{Binding EasyCount, StringFormat={}E:{0}}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--  Row 3: Placeholder / Loading / DataGrid  -->
            <Border
                x:Name="pnlPlaceholder"
                Grid.Row="4"
                Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon
                        Width="48"
                        Height="48"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Foreground="#CBD5E1"
                        Kind="TableEye" />
                    <TextBlock
                        x:Name="txtPlaceholder"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text="Analysis ready. Click a chart point to view."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                x:Name="pnlLoading"
                Grid.Row="4"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar
                        Width="36"
                        Height="36"
                        IsIndeterminate="True"
                        Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#94A3B8"
                        Text="LOADING ANALYSIS..." />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="3"
                Margin="0,0,0,8"
                Background="#F7F8F4"
                BorderBrush="#E2E8F0"
                BorderThickness="0.5"
                CornerRadius="8">
                <WrapPanel Margin="12,8">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Black"
                        Foreground="#94A3B8"
                        Text="SORT BY" />
                    <RadioButton
                        x:Name="rbSortNumber"
                        Margin="0,0,6,0"
                        Checked="SortChanged"
                        Content="Question order"
                        GroupName="SortGroup"
                        IsChecked="True"
                        />

                    <RadioButton
                        x:Name="rbSortCorrect"
                        Margin="0,0,6,0"
                        Checked="SortChanged"
                        Content="Correct rate"
                        GroupName="SortGroup"
                        />
                    <RadioButton
                        x:Name="rbSortDistractor"
                        Margin="0,0,6,0"
                        Checked="SortChanged"
                        Content="Wrong-choice rate"
                        GroupName="SortGroup"
                        />
                    <!-- <RadioButton
                        x:Name="rbSortDelta"
                        Checked="SortChanged"
                        Content="Δ vs prev"
                        GroupName="SortGroup"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />-->
                    <Separator Margin="10,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <RadioButton
                        x:Name="rbAsc"
                        Margin="0,0,4,0"
                        Checked="SortChanged"
                        Content="↑ Asc"
                        GroupName="OrderGroup"
                        IsChecked="True"
                        />
                    <RadioButton
                        x:Name="rbDesc"
                        Checked="SortChanged"
                        Content="↓ Desc"
                        GroupName="OrderGroup"
                        />
                </WrapPanel>
            </Border>

            <DataGrid
                x:Name="dgItems"
                Grid.Row="4"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CellStyle="{StaticResource AnalysisCellStyle}"
                EnableRowVirtualization="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.CanContentScroll="True"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                AreRowDetailsFrozen="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                LoadingRow="DgItems_LoadingRow"
                MouseLeftButtonDown="dgItems_MouseLeftButtonUp"
                RowDetailsVisibilityMode="VisibleWhenSelected"
                RowStyle="{StaticResource AnalysisRowStyle}"
                SelectionMode="Single"
                Visibility="Collapsed">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F7F8F4" />
                        <Setter Property="Foreground" Value="#64748B" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="FontWeight" Value="Black" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!--  Q#  -->
                    <DataGridTextColumn
                        Width="40"
                        Binding="{Binding RowNumber}"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#CBD5E1"
                        Header="Q#" />

                    <DataGridTextColumn
                        Width="55"
                        Binding="{Binding CorrectAnswer}"
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#64748B"
                        Header="ANS" />

                    <!--  Question text  -->
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="180"
                        Header="ITEM TEXT">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Margin="0,8,18,8"
                                        FontSize="13"
                                        Text="{Binding QuestionText}"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding QuestionText}" />
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#A5B4FC"
                                        Kind="RobotOutline">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnalysis}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Correct %  -->
                    <DataGridTemplateColumn Width="86" Header="CORRECT %">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Black"
                                    Foreground="{Binding DifficultyColor}"
                                    Text="{Binding PValueLabel}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Δ vs prev batch  -->
                    <!-- <DataGridTemplateColumn Width="68" Header="VS PREV">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Black"
                                        Foreground="{Binding DeltaColor}"
                                        Text="{Binding DeltaLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->

                    <DataGridTemplateColumn Width="220" Header="CHOICE DISTRIBUTION">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding ChoiceMetrics}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2" Padding="6,3" CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsCorrect}" Value="True"><Setter Property="Background" Value="#DCFCE7" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11">
                                                    <Run FontWeight="Bold" Text="{Binding Label}" /><Run Text=": " /><Run Text="{Binding Percentage, StringFormat={}{0:N1}%}" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Top distractor  -->
                    <DataGridTemplateColumn Width="92" Header="TOP WRONG">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#F59E0B"
                                    Text="{Binding TopDistractor}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <!--  Row expand: AI insight with left accent border  -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border
                            Width="{Binding ActualWidth, ElementName=dgItems}"
                            Padding="16,14"
                            Background="#F7F8F4"
                            BorderBrush="#C7D2FE"
                            BorderThickness="3,0,0,0"
                            CornerRadius="0,8,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold" Text="{Binding QuestionText}" TextWrapping="Wrap" />
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Foreground="#247968"
                                        Kind="RobotOutline" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Black"
                                        Foreground="#247968"
                                        Text="AI DIAGNOSTIC INSIGHT" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="2"
                                    FontSize="13"
                                    Foreground="#475569"
                                    LineHeight="20"
                                    Text="{Binding AiAnalysis, TargetNullValue='No AI diagnostic generated for this item.'}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
