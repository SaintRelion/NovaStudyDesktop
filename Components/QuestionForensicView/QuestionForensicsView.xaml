<UserControl
    x:Class="Components.QuestionForensicsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="#F7F8F4" CornerRadius="12">
        <Grid>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#247968"
                                Kind="Brain" />
                            <TextBlock
                                x:Name="txtTitle"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Black"
                                Text="DEEP AI FORENSICS" />
                        </StackPanel>
                        <TextBlock
                            x:Name="txtSubtitle"
                            Margin="36,0,0,0"
                            FontSize="12"
                            Opacity="0.5"
                            Text="Select a topic to read detailed AI reasoning for each item." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="btnToggleAI"
                            Margin="0,0,8,0"
                            BorderBrush="#247968"
                            Click="ToggleAI_Click"
                            Content="Hide AI Breakdown"
                            FontSize="11"
                            Foreground="#247968"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colRevieweeStrip" Width="0" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="pnlRevieweeStrip"
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Padding="8"
                        Background="White"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.05"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="8,8,0,12"
                                FontSize="11"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="REVIEWEES" />
                            <ListBox
                                x:Name="lstReviewees"
                                Grid.Row="1"
                                BorderThickness="0"
                                DisplayMemberPath="username"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="Reviewee_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0,0,24,0"
                        Padding="8"
                        Background="White"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.05"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="8,8,0,12"
                                FontSize="11"
                                FontWeight="Black"
                                Opacity="0.5"
                                Text="FILTER BY TOPIC" />

                            <ListBox
                                x:Name="lstTopics"
                                Grid.Row="1"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="Topic_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="bd"
                                                        Padding="16,12"
                                                        Background="#F1F3F5"
                                                        CornerRadius="6"
                                                        Cursor="Hand">
                                                        <TextBlock
                                                            x:Name="txt"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#333"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#E9ECEF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#247968" />
                                                            <Setter TargetName="txt" Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Kind="FilterVariant" />
                                <ComboBox
                                    x:Name="cmbStatusFilter"
                                    Width="160"
                                    materialDesign:HintAssist.Hint="Status Filter"
                                    SelectionChanged="Status_SelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="ALL QUESTIONS" IsSelected="True" />
                                    <ComboBoxItem Content="CORRECT ONLY" />
                                    <ComboBoxItem Content="INCORRECT ONLY" />
                                </ComboBox>
                            </StackPanel>

                            <TextBlock
                                x:Name="txtItemCount"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Opacity="0.6"
                                Text="0 Items" />
                        </Grid>

                        <ListBox
                            x:Name="lstForensicQuestions"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="mainBorder"
                                        Margin="0,0,12,24"
                                        Padding="20"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="4,1,1,1"
                                        CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="8"
                                                Opacity="0.05"
                                                ShadowDepth="1" />
                                        </Border.Effect>
                                        <StackPanel>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#247968"
                                                    Text="{Binding SlotName}" />
                                                <Border
                                                    x:Name="bdgStatus"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="txtStatus"
                                                        FontSize="10"
                                                        FontWeight="Black" />
                                                </Border>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,0,0,16"
                                                FontSize="15"
                                                FontWeight="Medium"
                                                Opacity="0.9"
                                                Text="{Binding QuestionText}"
                                                TextWrapping="Wrap" />

                                            <WrapPanel
                                                Margin="0,0,0,16"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">

                                                <materialDesign:PackIcon
                                                    x:Name="iconArrow"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,-4,12,8"
                                                    VerticalAlignment="Center"
                                                    Foreground="#BDBDBD"
                                                    Kind="ArrowRightThick" />

                                                <Border
                                                    x:Name="pillCurrent"
                                                    Margin="0,0,0,16"
                                                    Padding="12,10"
                                                    HorizontalAlignment="Left"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                                        <StackPanel x:Name="pnlPrevious" Margin="0,0,12,0">
                                                            <TextBlock
                                                                Margin="0,0,0,4"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Opacity="0.5"
                                                                Text="PREVIOUS ANSWER" />
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <TextBlock
                                                                    MaxWidth="200"
                                                                    FontSize="12"
                                                                    Opacity="0.6"
                                                                    Text="{Binding PreviousAnswer}"
                                                                    TextDecorations="Strikethrough"
                                                                    TextWrapping="Wrap" />

                                                                <materialDesign:PackIcon
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Kind="ArrowRightThick"
                                                                    Opacity="0.3" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock
                                                                Margin="0,0,0,4"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Opacity="0.5"
                                                                Text="LATEST ANSWER" />
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <materialDesign:PackIcon
                                                                    x:Name="iconCurrent"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    MaxWidth="250"
                                                                    FontSize="13"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding StudentAnswer}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <Border
                                                x:Name="borderAIBreakdown"
                                                Padding="16"
                                                Background="#F9F9FC"
                                                BorderBrush="#E2E2F2"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding IsAIVisible, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="14"
                                                            Height="14"
                                                            VerticalAlignment="Center"
                                                            Foreground="#247968"
                                                            Kind="AutoFix" />
                                                        <TextBlock
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="Black"
                                                            Foreground="#247968"
                                                            Text="AI LOGIC BREAKDOWN" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Black"
                                                        Opacity="0.5"
                                                        Text="Correct Answer:" />
                                                    <TextBlock
                                                        Margin="0,2,0,12"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="#2E7D32"
                                                        Text="{Binding CorrectAnswer}"
                                                        TextWrapping="Wrap" />

                                                    <ItemsControl ItemsSource="{Binding OptionAnalysis}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,8">
                                                                    <TextBlock FontSize="10" FontWeight="Black" Opacity="0.5" Text="{Binding Key, StringFormat='Option ({0})'}" />
                                                                    <TextBlock Margin="0,2,0,0" FontSize="13" Opacity="0.8" Text="{Binding Value}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding PreviousAnswer}" Value="">
                                            <Setter TargetName="pnlPrevious" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviousAnswer}" Value="{x:Null}">
                                            <Setter TargetName="pnlPrevious" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#4CAF50" />
                                            <Setter TargetName="bdgStatus" Property="Background" Value="#E8F5E9" />
                                            <Setter TargetName="txtStatus" Property="Text" Value="CORRECT" />
                                            <Setter TargetName="txtStatus" Property="Foreground" Value="#2E7D32" />

                                            <Setter TargetName="pillCurrent" Property="Background" Value="#E8F5E9" />
                                            <Setter TargetName="pillCurrent" Property="BorderBrush" Value="#A5D6A7" />
                                            <Setter TargetName="iconCurrent" Property="Kind" Value="CheckCircle" />
                                            <Setter TargetName="iconCurrent" Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#F44336" />
                                            <Setter TargetName="bdgStatus" Property="Background" Value="#FFEBEE" />
                                            <Setter TargetName="txtStatus" Property="Text" Value="INCORRECT" />
                                            <Setter TargetName="txtStatus" Property="Foreground" Value="#C62828" />

                                            <Setter TargetName="pillCurrent" Property="Background" Value="#FFEBEE" />
                                            <Setter TargetName="pillCurrent" Property="BorderBrush" Value="#EF9A9A" />
                                            <Setter TargetName="iconCurrent" Property="Kind" Value="CloseCircle" />
                                            <Setter TargetName="iconCurrent" Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <Border
                x:Name="pnlLoadingOverlay"
                Panel.ZIndex="10"
                Background="White"
                CornerRadius="12"
                Opacity="0.85"
                Visibility="Collapsed">
                <ProgressBar
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
