<UserControl
    x:Class="Components.CategoryGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SmartPrepModern.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
        <materialDesign:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border
        Margin="0,0,0,24"
        Background="White"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.05"
                ShadowDepth="1" />
        </Border.Effect>
        <StackPanel>
            <Border
                Padding="24,15"
                Background="#F7F8F4"
                CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="FolderOpen"
                            Opacity="0.6" />
                        <TextBlock
                            x:Name="txtCategoryName"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Black"
                            Opacity="0.8"
                            Text="CATEGORY NAME" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <!--  New Delete Category Button  -->
                        <Button
                            Margin="0,0,8,0"
                            Click="DeleteCategory_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Delete Empty Category">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Foreground="#E57373"
                                Kind="DeleteSweep" />
                        </Button>

                        <Button
                            Click="AddTopic_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Add New Topic Slot">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                Kind="PlusCircle" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="icSlots" Margin="24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card
                            Margin="0,0,0,12"
                            Padding="18"
                            Background="#FFFFFF"
                            BorderBrush="#F0F2F5"
                            BorderThickness="1"
                            UniformCornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Black"
                                        Foreground="#2D3436"
                                        Text="{Binding slot_name}" />
                                    <StackPanel
                                        Margin="0,4,0,0"
                                        Opacity="0.5"
                                        Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Kind="ClockOutline" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="{Binding created_at}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0" FontSize="10" FontWeight="Bold" Foreground="#7A5A00" Text="{Binding questionnaire_status_label}" ToolTip="{Binding questionnaire_error}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">

                                    <Button
                                        Padding="8,0"
                                        IsEnabled="{Binding can_modify}"
                                        Click="UploadFile_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Tag="material"
                                        ToolTip="Upload Study Material (PDF/DOC)">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Foreground="{Binding is_material_uploaded, Converter={StaticResource BoolToColorConverter}}" Kind="FileCheck" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="Black"
                                                Text=" MATERIAL" />
                                        </StackPanel>
                                    </Button>

                                    <Separator
                                        Width="1"
                                        Height="20"
                                        Margin="10,0"
                                        Background="#EEE" />

                                    <Button
                                        Padding="8,0"
                                        IsEnabled="{Binding can_modify}"
                                        Click="UploadFile_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Tag="questionnaire"
                                        ToolTip="Upload Questionnaire for AI Extraction">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Foreground="{Binding is_questionnaire_extracted, Converter={StaticResource BoolToColorConverter}}" Kind="FileCheck" />

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="Black"
                                                Text="{Binding item_count, StringFormat=' {0} ITEMS'}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Margin="5,0"
                                        IsEnabled="{Binding can_modify}"
                                        Click="ViewQuestions_Click"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="View/Preview Questions">
                                        <materialDesign:PackIcon Foreground="{StaticResource BrandPrimary}" Kind="EyeOutline" />
                                    </Button>

                                    <Button
                                        Margin="5,0"
                                        IsEnabled="{Binding can_modify}"
                                        Click="RenameSlot_Click"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Rename Topic">
                                        <materialDesign:PackIcon Foreground="#F39C12" Kind="PencilOutline" />
                                    </Button>

                                    <Button
                                        Margin="15,0,0,0"
                                        IsEnabled="{Binding can_modify}"
                                        Click="DeleteSlot_Click"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Delete Entire Slot">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Foreground="#B2BEC3"
                                            Kind="DeleteOutline" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
