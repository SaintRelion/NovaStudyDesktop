<UserControl
    x:Class="Components.UniversalStatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartPrepModern.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="White"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="24,32" Background="#1A1A1A">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtOverallComp"
                            FontSize="54"
                            FontWeight="Black"
                            Foreground="White"
                            Text="0%" />
                        <TextBlock
                            x:Name="txtAccuracyLabel"
                            FontWeight="Bold"
                            Foreground="White"
                            Opacity="0.5"
                            Text="OVERALL ACCURACY" />
                    </StackPanel>
                </Border>

                <Border Padding="32">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,16"
                            FontWeight="Black"
                            Opacity="0.6"
                            Text="TOPIC COMPETENCY BREAKDOWN" />

                        <ItemsControl x:Name="icTopicBreakdown">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        MinWidth="280"
                                        MaxWidth="350"
                                        Margin="0,0,16,16"
                                        Padding="16"
                                        Background="#F8F8F8"
                                        CornerRadius="8"
                                        Cursor="Hand">
                                        <Grid>
                                            <StackPanel>
                                                <!--  Category Label  -->
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Text="{Binding label}"
                                                    TextWrapping="Wrap" />

                                                <!--  Category Progress Bar  -->
                                                <ProgressBar
                                                    Height="4"
                                                    Margin="0,8"
                                                    Background="#DDD"
                                                    Foreground="#176B5C"
                                                    Value="{Binding percentage}" />

                                                <!--  Nested Topics (Slots) Breakdown  -->
                                                <ItemsControl Margin="0,5,0,10" ItemsSource="{Binding slots}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!--  Slot Name and Raw Score: e.g. "Fire 1 (5/10)"  -->
                                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Opacity="0.7"
                                                                        Text="{Binding slot_name}"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        Margin="6,0,0,0"
                                                                        FontSize="11"
                                                                        Opacity="0.5">
                                                                        <Run Text="(" /><Run Text="{Binding score}" /><Run Text="/" /><Run Text="{Binding total}" /><Run Text=")" />
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <!--  Percentage: e.g. "26%"  -->
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="12,0,0,0"
                                                                    FontSize="11"
                                                                    FontWeight="Black"
                                                                    Opacity="0.8"
                                                                    Text="{Binding percentage, StringFormat='{}{0:N0}%'}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!--  Category Footer (Overall Score)  -->
                                                <Border
                                                    Margin="0,4,0,0"
                                                    Padding="0,8,0,0"
                                                    BorderBrush="#EEE"
                                                    BorderThickness="0,1,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="11" Opacity="0.6">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="COLLECTIVE AVG: " />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}" Value="Individual">
                                                                            <Setter Property="Text" Value="Scored " />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Opacity="0.8"
                                                            Text="{Binding score}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Opacity="0.6"
                                                            Text=" / " />
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Opacity="0.8"
                                                            Text="{Binding total}" />
                                                        <TextBlock
                                                            Margin="4,0,0,0"
                                                            FontSize="11"
                                                            Opacity="0.6"
                                                            Text=" Points" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Button
                                                x:Name="btnDeepAnalysis"
                                                Width="32"
                                                Height="32"
                                                Margin="0,-8,-8,0"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="btnDeepAnalysis_Click"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="View Deep AI Item Analysis">
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#247968"
                                                    Kind="Brain" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Padding="32,0,32,32">
                    <materialDesign:Card
                        Padding="24"
                        Background="#F7F8F4"
                        UniformCornerRadius="12">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <materialDesign:PackIcon Foreground="{DynamicResource PrimaryHueMidBrush}" Kind="AutoFix" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    FontWeight="Black"
                                    Opacity="0.6"
                                    Text="AI PERFORMANCE INSIGHTS" />

                                <TextBlock
                                    x:Name="txtAnalysisWarning"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="#E67E22"
                                    Text="(Pending or Draft - More students expected)"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock
                                x:Name="txtAiSummary"
                                Margin="0,0,0,16"
                                FontSize="14"
                                LineHeight="22"
                                Text="Select an exam to view AI-generated summary and recommendations."
                                TextWrapping="Wrap" />

                            <ItemsControl x:Name="lstAiRecommendations">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="14"
                                                Margin="0,2,0,0"
                                                Foreground="#F1C40F"
                                                Kind="LightbulbOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                FontSize="13"
                                                Opacity="0.8"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button
                                x:Name="btnRefreshAI"
                                Height="32"
                                Margin="0,20,0,0"
                                Click="btnRefreshAI_Click"
                                Content="GENERATE / RE-RUN BATCH ANALYSIS"
                                FontSize="10"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </materialDesign:Card>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <Border
            x:Name="pnlEmptyState"
            Background="White"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Foreground="#DDD"
                    Kind="AccountQuestion" />
                <TextBlock
                    Margin="0,16,0,4"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Black"
                    Opacity="0.8"
                    Text="NO EXAMINEE DATA" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="Gray"
                    Text="There are no results recorded for this examination yet." />
            </StackPanel>
        </Border>

        <Border
            x:Name="pnlLoading"
            Grid.RowSpan="10"
            Panel.ZIndex="1000"
            Background="White"
            Opacity="0.8"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="48"
                    Height="48"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="0" />
                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Black"
                    Opacity="0.6"
                    Text="Analyzing..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
