<UserControl
    x:Class="Components.ExamConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="350"
    mc:Ignorable="d">
    <Border Padding="20" Background="#F7F8F4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> 
                <RowDefinition Height="*" />    
                <RowDefinition Height="Auto" /> 
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock
                    FontSize="18"
                    FontWeight="Black"
                    Text="EXAM CONFIGURATION" />
                <TextBox
                    x:Name="txtExamName"
                    Margin="0,15,0,0"
                    materialDesign:HintAssist.Hint="Enter Exam Title"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <CheckBox
                    x:Name="chkRandomize"
                    Margin="0,10,0,0"
                    Content="Randomize Question Order"
                    IsChecked="True" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="lstStaged">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="{Binding slot_name}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBox
                                        Grid.Column="1"
                                        HorizontalContentAlignment="Center"
                                        materialDesign:HintAssist.Hint="Qty"
                                        Style="{StaticResource MaterialDesignTextBox}"
                                        Text="{Binding items_to_pull, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="txtItemsToPull_TextChanged" />

                                    <Button
                                        Grid.Column="2"
                                        Click="btnRemoveStaged_Click"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" />
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Border
                    Padding="0,15"
                    BorderBrush="#DDD"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock
                            x:Name="txtTotalCounter"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Black"
                            Foreground="Red"
                            Text="Total: 0" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Bold"
                            Opacity="0.5"
                            Text="/ 100 REQUIRED" />
                    </Grid>
                </Border>

                <Button
                    x:Name="btnGenerate"
                    Height="50"
                    Click="btnGenerate_Click"
                    Content="GENERATE EXAM"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
