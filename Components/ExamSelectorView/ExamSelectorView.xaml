<UserControl
    x:Class="Components.ExamSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border
        Background="White"
        BorderBrush="#DDD"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="16"
                Background="White"
                BorderBrush="#EEE"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock
                            x:Name="txtHeaderText"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Black"
                            Text="EXAMINATION REPOSITORY" />
                    </Grid>

                    <Border
                        Padding="8,2"
                        Background="#F5F3EE"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                VerticalAlignment="Center"
                                Kind="Search"
                                Opacity="0.5" />
                            <TextBox
                                x:Name="txtSearch"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                materialDesign:HintAssist.Hint="Search exam name..."
                                Background="Transparent"
                                BorderThickness="0"
                                TextChanged="txtSearch_TextChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <ListBox
                x:Name="lstExams"
                Grid.Row="1"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,32">

                            <Border
                                Margin="0,0,0,12"
                                Padding="20,12"
                                Background="#F2F2F2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Black"
                                    Foreground="#555"
                                    Opacity="0.6"
                                    Text="{Binding exam_date}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding exams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="brdExamCard"
                                            MinHeight="100"
                                            Margin="16,8"
                                            Padding="20,18"
                                            Background="White"
                                            BorderBrush="#DDD"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ExamCard_Click">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="10"
                                                    Opacity="0.05"
                                                    ShadowDepth="1" />
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    FontSize="16"
                                                    FontWeight="Black"
                                                    Foreground="#1A1A1A"
                                                    Text="{Binding exam_name}"
                                                    TextWrapping="Wrap" />

                                                <Grid Grid.Row="1" Margin="0,15,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            Kind="ClockOutline"
                                                            Opacity="0.5" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Opacity="0.6"
                                                            Text="{Binding created_at}" />
                                                    </StackPanel>

                                                    <Border
                                                        Padding="8,4"
                                                        VerticalAlignment="Center"
                                                        Background="#F5F3EE"
                                                        CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="Black"
                                                                Text="{Binding metric_count}" />

                                                            <TextBlock
                                                                x:Name="txtMetricLabel"
                                                                Margin="4,0,0,0"
                                                                FontSize="10"
                                                                FontWeight="Black"
                                                                Opacity="0.5"
                                                                Text="REVIEWEE" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=CurrentRole}" Value="Reviewee">
                                                <Setter TargetName="txtMetricLabel" Property="Text" Value="ATTEMPTS" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border
                x:Name="pnlLoading"
                Background="White"
                Opacity="0.7"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar
                        Width="30"
                        Height="30"
                        IsIndeterminate="True"
                        Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="Black"
                        Opacity="0.5"
                        Text="LOADING REVIEWEES..." />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
