<Application
    x:Class="Application"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SmartPrepModern"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <materialDesign:CustomColorTheme
                    BaseTheme="Light"
                    PrimaryColor="#176B5C"
                    SecondaryColor="#82BDA7" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandPrimary" Color="#176B5C" />
            <SolidColorBrush x:Key="BrandSecondary" Color="#82BDA7" />
            <SolidColorBrush x:Key="BrandDeep" Color="#173D3C" />
            <SolidColorBrush x:Key="BrandAccent" Color="#247968" />
            <SolidColorBrush x:Key="AppCanvas" Color="#F5F3EE" />
            <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppInk" Color="#1B2634" />
            <SolidColorBrush x:Key="AppMuted" Color="#586474" />
            <SolidColorBrush x:Key="AppBorder" Color="#DCE3DD" />
            <SolidColorBrush x:Key="BrandHighlight" Color="#176B5C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
