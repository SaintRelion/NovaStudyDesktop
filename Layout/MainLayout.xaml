<UserControl x:Class="Layout.MainLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{StaticResource AppCanvas}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="60" /><RowDefinition Height="84" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrandDeep}">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource BrandAccent}" CornerRadius="7">
                        <materialDesign:PackIcon Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="BookEducationOutline" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="White" Text="nova study" />
                    <TextBlock Margin="22,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#A7CABB" Text="ASSESSMENT WORKSPACE" />
                </StackPanel>
                <Button x:Name="btnLogout" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Logout_Click" Foreground="#D4E8DF" Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="18" Height="18" Kind="Logout" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Sign out" /></StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SidebarButtons" Margin="26,11" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="30,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Text="WORKSPACE / CURRENT VIEW" />
                <TextBlock x:Name="txtHeaderTitle" Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AppInk}" Text="Overview" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="11,7" Background="#E7F2EC" CornerRadius="14">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Text="Workspace online" />
            </Border>
        </Grid>
        <Border Grid.Row="3" Margin="28,0,28,26" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="14">
            <materialDesign:DialogHost x:Name="MainDialogHost" Identifier="MainDialogHost">
                <ContentControl x:Name="MainContent" />
            </materialDesign:DialogHost>
        </Border>
    </Grid>
</UserControl>
